# ============================================================
# 环境变量模板：复制本文件为 .env 后按实际情况修改
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交到仓库
# ============================================================

# ---------- 服务 ----------
PORT=3000
NODE_ENV=development

# ---------- MySQL ----------
DB_HOST=localhost
DB_NAME=chat_room
DB_USER=admin
DB_PASSWORD=your_mysql_password

# ---------- 密钥 ----------
# AES 消息传输加密密钥（用于 utils/encryption.js）
AES_SECRET_KEY=please-change-me-to-a-random-32-char-string
# express-session 签名密钥（用于 server.js）
SESSION_SECRET=please-change-me-to-another-random-string

# 生成随机密钥的参考命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
